{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/persistent-event-log-and-replay/schemas/stream-request.schema.json",
  "title": "Stream creation and retention policy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capacityBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "segmentMaxRecords": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "segmentMaxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "retention": {
      "type": "object",
      "properties": {
        "minimumAgeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "targetRetainedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "minimumAgeSeconds",
        "targetRetainedBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "capacityBytes",
    "segmentMaxRecords",
    "segmentMaxBytes",
    "retention"
  ],
  "additionalProperties": false
}
