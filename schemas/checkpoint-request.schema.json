{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/persistent-event-log-and-replay/schemas/checkpoint-request.schema.json",
  "title": "Fenced group checkpoint commit",
  "type": "object",
  "properties": {
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nextOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "instanceId",
    "epoch",
    "nextOffset"
  ],
  "additionalProperties": false
}
